# ---------------------------------------------------------------------------
# Production build values. Committed on purpose (see .gitignore) because they
# are public, build-time constants that Vite inlines into the bundle — never
# put a secret in a VITE_* variable. A variable set in the host's dashboard
# takes precedence over this file.
# ---------------------------------------------------------------------------

# EMPTY ON PURPOSE — it means "the origin this page was served from".
#
# That is what the single-service Render deploy needs: one host serves the API
# and this bundle, so the auth cookies are first-party and no CORS is involved.
# Third-party cookies (frontend and API on different sites) are dropped by
# Safari, Brave and most blocker extensions, which shows up as a login that
# returns 200 and then leaves you signed out.
#
# Set this to the API's full URL, no trailing slash, ONLY if you go back to
# hosting the frontend and API separately.
VITE_API_URL=

# 'live' talks to VITE_API_URL; 'sandbox' runs entirely on offline mock data.
VITE_API_MODE=live

# Google OAuth 2.0 web client id for the "Continue with Google" button. Public,
# and must be the SAME value as the API's GOOGLE_CLIENT_ID. The deployed origin
# also has to be listed under "Authorized JavaScript origins" on that client in
# Google Cloud Console. Leave blank to hide the button.
VITE_GOOGLE_CLIENT_ID=
