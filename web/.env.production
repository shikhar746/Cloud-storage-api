# ---------------------------------------------------------------------------
# Production build values. Committed on purpose (see .gitignore) because they
# are public, build-time constants that Vite inlines into the bundle — never
# put a secret in a VITE_* variable.
#
# The API URL is NOT here. There is one backend and no runtime switching, so
# it is a constant in web/src/services/api.ts (API_BASE_URL).
# ---------------------------------------------------------------------------

# Google OAuth 2.0 web client id for the "Continue with Google" button. Public
# by design — it is readable in the bundle either way — and must be the SAME
# value as the API's GOOGLE_CLIENT_ID, which the API prints on boot.
#
# The origin serving this bundle must also be listed under "Authorized
# JavaScript origins" on that client in Google Cloud Console, or Google refuses
# to render the button. Blank hides the button entirely.
VITE_GOOGLE_CLIENT_ID=628438887723-mnqq2r7pvc3ojldbmctrj94c0lp1lbh8.apps.googleusercontent.com
