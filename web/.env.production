# Build-time config for production builds (`vite build` runs in "production"
# mode, so Vite loads this file automatically — unlike .env.vercel, which is
# not a Vite mode and has never been read by any build).
#
# These values are committed on purpose. Vite inlines them into the public
# JS bundle, so none of them is a secret; keeping them here means a Vercel
# deploy is correct without depending on dashboard environment variables.
# Anything genuinely secret belongs in the API, never in this file.

VITE_API_URL=https://cloud-storage-api-hquw.onrender.com
VITE_API_MODE=live
VITE_GOOGLE_CLIENT_ID=628438887723-mnqq2r7pvc3ojldbmctrj94c0lp1lbh8.apps.googleusercontent.com
