# ---------------------------------------------------------------------------
# Web environment (Vercel / any static host)
#
# Copy to .env for local work. On Vercel, drag this file (filled in) onto
# Project > Settings > Environment Variables to import every key at once.
#
# These are BUILD-time values: Vite inlines them into the bundle, so changing
# one in the dashboard does nothing until you redeploy. They also ship to the
# browser in plain text — never put a secret here.
# ---------------------------------------------------------------------------

# Base URL of the API service. No trailing slash (one is stripped anyway).
# Locally this is the API dev server; in production it is the Render URL.
#   VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=http://localhost:8080

# 'live' talks to VITE_API_URL; 'sandbox' runs entirely on offline mock data.
VITE_API_MODE=live

# Google OAuth 2.0 Web application client ID, used by the "Continue with
# Google" button on the sign-in page. Must be the SAME value as the API's
# GOOGLE_CLIENT_ID, and this site's origin must appear under "Authorized
# JavaScript origins" on that client in Google Cloud Console. Leave blank to
# hide the button.
VITE_GOOGLE_CLIENT_ID=
