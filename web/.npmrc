# Vite and the TypeScript toolchain live in devDependencies. A production build
# environment sets NODE_ENV=production, and npm reads that as --omit=dev — so a
# plain `npm install` skips vite and the build dies on "vite: not found".
#
# `include` wins over the implied omit, so dev dependencies are installed
# whatever NODE_ENV says and any build command works, not just one carrying an
# explicit --include=dev. Mirrors api/.npmrc.
include=dev
