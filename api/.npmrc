# The build runs `tsc`, which lives in devDependencies. Render sets
# NODE_ENV=production in the build environment, and npm reads that as
# --omit=dev — so a plain `npm install` skips TypeScript and @types/node, and
# the build dies on "Cannot find type definition file for 'node'" (TS2688).
#
# `include` wins over the implied `omit`, so dev dependencies are installed
# whatever NODE_ENV says and any build command works, not just one carrying
# an explicit --include=dev.
include=dev
