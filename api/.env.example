# ---------------------------------------------------------------------------
# API environment (Render / any Node host)
#
# Copy to .env for local work. On Render, paste the whole file into
# Environment > Add from .env instead of adding keys one by one.
# Anything marked REQUIRED makes the process refuse to boot when missing —
# it names every gap at once in the deploy log, so you only redeploy once.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Leave PORT unset on Render: the platform injects its own and the app binds
# to it. Locally it falls back to 8080.
PORT=8080
# MUST be "production" on a real deployment. It flips the auth cookies to
# SameSite=None; Secure, without which the browser drops them on every
# cross-site request from the frontend and login silently does nothing.
NODE_ENV=development
# Comma-separated browser origins allowed to call this API with credentials.
# No trailing slashes. "*" is a wildcard segment, so one entry covers every
# Vercel preview deploy. Add your production domain here too.
#   CORS_ORIGIN=https://your-app.vercel.app,https://*.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Authentication (REQUIRED) --------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use different values for the two, and different values than local dev.
JWT_SECRET=
REFRESH_SECRET=
# Token lifetimes, e.g. 15m / 1h / 7d.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Supabase (REQUIRED) --------------------------------------------------
# Project URL and the SERVICE ROLE key from Supabase > Project Settings > API.
# The service role key bypasses row-level security — it belongs on the server
# only, never in the web bundle.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Name of the storage bucket holding uploaded files.
SUPABASE_STORAGE_BUCKET=drive

# --- Google Sign-In (optional) --------------------------------------------
# OAuth 2.0 "Web application" client from
# https://console.cloud.google.com/apis/credentials
#
# Only the client id is used, and it is NOT a secret — it ships in the web
# bundle in plain text. The browser gets an ID token from Google Identity
# Services and this API only verifies its signature against Google's public
# certs; there is no authorization-code exchange, so no client secret is
# involved. GOOGLE_CLIENT_SECRET is not read and can be deleted.
#
# Three things must agree or sign-in fails:
#   1. this value
#   2. VITE_GOOGLE_CLIENT_ID in the web build — the SAME id
#   3. every origin the app is served from, listed under "Authorized
#      JavaScript origins" on that client:
#        https://your-service.onrender.com
#        http://localhost:5173
#        http://localhost:3000
#
# The boot log prints the id it loaded, so a mismatch is visible immediately.
# Leave blank to disable POST /api/auth/google and hide the button.
GOOGLE_CLIENT_ID=

# --- Uploads --------------------------------------------------------------
# Uploads at or under MAX_FILE_SIZE_BYTES go through POST /api/files/upload
# (multipart, buffered in API memory). Anything larger must use the signed-URL
# path: POST /api/files/upload-url then POST /api/files/complete. Keep this
# modest on a small instance — the whole file sits in RAM.
MAX_FILE_SIZE_BYTES=52428800
# Ceiling for the direct-to-storage path. Keep at or below the Supabase
# bucket's own file size limit (Storage > bucket > settings), default 5 GiB.
MAX_DIRECT_UPLOAD_BYTES=5368709120
